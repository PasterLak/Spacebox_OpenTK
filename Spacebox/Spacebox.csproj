<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<StartupObject>Spacebox.Program</StartupObject>
		<PackageIcon>logo.png</PackageIcon>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>Resources\Textures\icon.ico</ApplicationIcon>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>DEBUG;TRACE;PROFILING;ASSERTS;AGENT_API</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<DefineConstants>TRACE;AGENT_API</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Profile'">
		<DefineConstants>DEBUG;TRACE;PROFILING;ASSERTS;AGENT_API</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Final'">
		<Compile Remove="Agent\**" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' Or '$(Configuration)' == 'Final'">
		<OutputType>WinExe</OutputType>
	</PropertyGroup>

	<PropertyGroup Condition="('$(Configuration)' == 'Release' Or '$(Configuration)' == 'Final') And '$(RuntimeIdentifier)' != ''">
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

	<PropertyGroup>
		<LaunchScripts Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">windows</LaunchScripts>
		<LaunchScripts Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">unix</LaunchScripts>
		<LaunchScripts Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">windows</LaunchScripts>
		<LaunchScripts Condition="'$(LaunchScripts)' == ''">unix</LaunchScripts>
	</PropertyGroup>

	<ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win'))">
		<None Include="Build\AddAfterBuild\OpenAL32.dll" Link="OpenAL32.dll" Visible="false">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</None>
	</ItemGroup>

	<ItemDefinitionGroup>
		<Content>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</Content>
	</ItemDefinitionGroup>

	<PropertyGroup Condition="'$(Configuration)' != 'Release' And '$(Configuration)' != 'Final'">
		<OutputType>Exe</OutputType>
	</PropertyGroup>




	<ItemGroup>
		<PackageReference Include="ImGui.NET" Version="1.91.0.1" />
		<PackageReference Include="NVorbis" Version="0.10.5" />
		<PackageReference Include="OpenTK" Version="4.8.2" />
		<PackageReference Include="SharpCompress" Version="0.39.0" />
		<PackageReference Include="SharpNBT" Version="1.3.1" />
	</ItemGroup>
	
	<ItemGroup>
  <None Remove="SpaceboxTests\**" />
  <None Remove="Spacebox.Benchmarks\**" />
</ItemGroup>

	<ItemGroup>
		<Content Include="Resources\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Resources\Shaders\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<None Update="serverconfig.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="Spacebox Server Guide.pdf">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
		</None>
		<None Update="start-server.bat" Condition="'$(LaunchScripts)' == 'windows'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="start-server.sh;start.sh" Condition="'$(LaunchScripts)' == 'unix'">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<Content Include="GameSets\**\*.*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>


	<ItemGroup>
		<ProjectReference Include="..\Engine\Engine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Resources\Textures\logo.png">
			<Pack>true</Pack>
			<PackagePath>\\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="GameSets\Default\Generation\Loot\" />
	  <Folder Include="GameSets\Default\AI\" />
	  <Folder Include="GameSets\Default\Models\" />
	</ItemGroup>



</Project>
